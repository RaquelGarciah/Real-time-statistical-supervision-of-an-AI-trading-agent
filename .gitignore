# Notebook scratch local
notebooks/logic_esential.ipynb

# Muestras de estilo de Raquel: PRIVADAS (repo público). Solo se versiona el README;
# los textos propios (TFB, ensayos…) se quedan en local para calibrar el estilo.
tesis_assets/estilo_raquel/*
!tesis_assets/estilo_raquel/README.md

# Memoria compartida entre sesiones: es tooling local, no parte del TFG. Su .venv y
# __pycache__ ya están ignorados arriba; la memory.db es binaria y reconstruible, así
# que se queda en local entera.
claude_shared_memory/
