\@writefile{toc}{\contentsline {section}{\numberline {5.1}La intervención en detalle}{24}{section.5.1}\protected@file@percent }
\newlabel{sec:spy-anatomia}{{5.1}{24}{La intervención en detalle}{section.5.1}{}}
\newlabel{sec:spy-anatomia@cref}{{[section][1][5]5.1}{[1][24][]24}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.1}{\ignorespaces Regímenes del HMM ($K = 3$) sobre el precio de SPY en el periodo de evaluación. Calma (volatilidad baja, retorno medio positivo), Estrés (intermedio) y Crisis (volatilidad alta, retorno medio negativo) ordenan por la firma del \emph  {leverage effect}. El sombreado marca el régimen vigente cada día; la coincidencia régimen$\leftrightarrow $caída es contemporánea, no predictiva.}}{25}{figure.5.1}\protected@file@percent }
\newlabel{fig:mp-regimenes-spy}{{5.1}{25}{Regímenes del HMM ($K = 3$) sobre el precio de SPY en el periodo de evaluación. Calma (volatilidad baja, retorno medio positivo), Estrés (intermedio) y Crisis (volatilidad alta, retorno medio negativo) ordenan por la firma del \emph {leverage effect}. El sombreado marca el régimen vigente cada día; la coincidencia régimen$\leftrightarrow $caída es contemporánea, no predictiva}{figure.5.1}{}}
\newlabel{fig:mp-regimenes-spy@cref}{{[figure][1][5]5.1}{[1][25][]25}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5.1}{\ignorespaces Actividad de los tres detectores sobre el OOS completo de SPY ($n = 401$ días). ``Acierto'' es la fracción de direcciones correctas en los días en que el detector dispara; el P\&L de rescate es el acumulado de la intervención en esos días. PSA y GSO apenas disparan: su columna de acierto no aplica.}}{25}{table.5.1}\protected@file@percent }
\newlabel{tab:mp-detectores}{{5.1}{25}{Actividad de los tres detectores sobre el OOS completo de SPY ($n = 401$ días). ``Acierto'' es la fracción de direcciones correctas en los días en que el detector dispara; el P\&L de rescate es el acumulado de la intervención en esos días. PSA y GSO apenas disparan: su columna de acierto no aplica}{table.5.1}{}}
\newlabel{tab:mp-detectores@cref}{{[table][1][5]5.1}{[1][25][]25}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5.2}{\ignorespaces Modos de intervención de M8 sobre SPY (días en mercado, $n = 232$). El modo canónico (\emph  {override}) reorienta la posición al signo del régimen; las alternativas se abstienen o reducen el tamaño. En negrita, el modo adoptado.}}{26}{table.5.2}\protected@file@percent }
\newlabel{tab:mp-variantes}{{5.2}{26}{Modos de intervención de M8 sobre SPY (días en mercado, $n = 232$). El modo canónico (\emph {override}) reorienta la posición al signo del régimen; las alternativas se abstienen o reducen el tamaño. En negrita, el modo adoptado}{table.5.2}{}}
\newlabel{tab:mp-variantes@cref}{{[table][2][5]5.2}{[1][26][]26}{}{}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5.2}Comparación de las seis estrategias}{26}{section.5.2}\protected@file@percent }
\newlabel{sec:spy-estrategias}{{5.2}{26}{Comparación de las seis estrategias}{section.5.2}{}}
\newlabel{sec:spy-estrategias@cref}{{[section][2][5]5.2}{[1][26][]26}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5.3}{\ignorespaces Las seis estrategias sobre SPY, ventana desplegable ($n = 251$, \texttt  {signal\_lag}${}=1$). Accuracy direccional, Sharpe anualizado, máxima caída, ratio de Calmar \blx@tocontentsinit {0}\cite {young1991} y capital final por euro invertido. En negrita, la mejor en cada columna.}}{26}{table.5.3}\protected@file@percent }
\newlabel{tab:mp-spy}{{5.3}{26}{Las seis estrategias sobre SPY, ventana desplegable ($n = 251$, \texttt {signal\_lag}${}=1$). Accuracy direccional, Sharpe anualizado, máxima caída, ratio de Calmar \cite {young1991} y capital final por euro invertido. En negrita, la mejor en cada columna}{table.5.3}{}}
\newlabel{tab:mp-spy@cref}{{[table][3][5]5.3}{[1][26][]26}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.2}{\ignorespaces Matrices de confusión de las seis estrategias sobre SPY, dirección predicha frente a la real. Enseñan de dónde sale el acierto de cada una, no solo su porcentaje: el agente carga el error en una clase y las derivadas de STRATA lo reparten mejor.}}{27}{figure.5.2}\protected@file@percent }
\newlabel{fig:mp-confusion-spy6}{{5.2}{27}{Matrices de confusión de las seis estrategias sobre SPY, dirección predicha frente a la real. Enseñan de dónde sale el acierto de cada una, no solo su porcentaje: el agente carga el error en una clase y las derivadas de STRATA lo reparten mejor}{figure.5.2}{}}
\newlabel{fig:mp-confusion-spy6@cref}{{[figure][2][5]5.2}{[1][26][]27}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.3}{\ignorespaces Curvas de capital de las seis estrategias sobre SPY (ventana desplegable, $n = 251$ días, un euro inicial). AutoML (línea destacada) supera a las dos referencias triviales en Sharpe ($+2{,}68$ frente a $+2{,}21$), en máxima caída ($-5{,}5\%$ frente a $-9{,}8\%$) y en capital final ($1{,}38\times $ frente a $1{,}30\times $); el agente solo (M5) termina en $0{,}70\times $. La ventaja sobre la trivial es nominal (McNemar AutoML vs ZeroR $p = 0{,}902$).}}{27}{figure.5.3}\protected@file@percent }
\newlabel{fig:mp-equity-spy}{{5.3}{27}{Curvas de capital de las seis estrategias sobre SPY (ventana desplegable, $n = 251$ días, un euro inicial). AutoML (línea destacada) supera a las dos referencias triviales en Sharpe ($+2{,}68$ frente a $+2{,}21$), en máxima caída ($-5{,}5\%$ frente a $-9{,}8\%$) y en capital final ($1{,}38\times $ frente a $1{,}30\times $); el agente solo (M5) termina en $0{,}70\times $. La ventaja sobre la trivial es nominal (McNemar AutoML vs ZeroR $p = 0{,}902$)}{figure.5.3}{}}
\newlabel{fig:mp-equity-spy@cref}{{[figure][3][5]5.3}{[1][27][]27}{}{}{}}
