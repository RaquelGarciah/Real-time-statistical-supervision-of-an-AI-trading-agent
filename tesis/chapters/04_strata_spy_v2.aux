\@writefile{toc}{\contentsline {section}{\numberline {5.1}La intervención en detalle}{25}{section.5.1}\protected@file@percent }
\newlabel{sec:spy-anatomia}{{5.1}{25}{La intervención en detalle}{section.5.1}{}}
\newlabel{sec:spy-anatomia@cref}{{[section][1][5]5.1}{[1][25][]25}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.1}{\ignorespaces Regímenes del HMM ($K = 3$) sobre el precio de SPY en el periodo de evaluación. Calma (volatilidad baja, retorno medio positivo), Estrés (intermedio) y Crisis (volatilidad alta, retorno medio negativo) ordenan por la firma del \emph  {leverage effect}. El sombreado marca el régimen vigente cada día; la coincidencia régimen$\leftrightarrow $caída es contemporánea, no predictiva.}}{25}{figure.caption.19}\protected@file@percent }
\newlabel{fig:mp-regimenes-spy}{{5.1}{25}{Regímenes del HMM ($K = 3$) sobre el precio de SPY en el periodo de evaluación. Calma (volatilidad baja, retorno medio positivo), Estrés (intermedio) y Crisis (volatilidad alta, retorno medio negativo) ordenan por la firma del \emph {leverage effect}. El sombreado marca el régimen vigente cada día; la coincidencia régimen$\leftrightarrow $caída es contemporánea, no predictiva}{figure.caption.19}{}}
\newlabel{fig:mp-regimenes-spy@cref}{{[figure][1][5]5.1}{[1][25][]25}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.2}{\ignorespaces Anatomía de un día de intervención sobre SPY: la decisión del agente entra en RAM, que la compara con el régimen filtrado; si choca y el \emph  {score} supera $\tau = 0{,}50$, la intervención la reorienta y el resultado se evalúa contra el retorno del día siguiente.}}{26}{figure.caption.20}\protected@file@percent }
\newlabel{fig:mp-anatomia}{{5.2}{26}{Anatomía de un día de intervención sobre SPY: la decisión del agente entra en RAM, que la compara con el régimen filtrado; si choca y el \emph {score} supera $\tau = 0{,}50$, la intervención la reorienta y el resultado se evalúa contra el retorno del día siguiente}{figure.caption.20}{}}
\newlabel{fig:mp-anatomia@cref}{{[figure][2][5]5.2}{[1][26][]26}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5.1}{\ignorespaces Actividad de los tres detectores sobre el OOS completo de SPY ($n = 401$ días). ``Acierto'' es la fracción de direcciones correctas en los días en que el detector dispara; el P\&L de rescate es el acumulado de la intervención en esos días. PSA y GSO apenas disparan: su columna de acierto no aplica.}}{26}{table.caption.21}\protected@file@percent }
\newlabel{tab:mp-detectores}{{5.1}{26}{Actividad de los tres detectores sobre el OOS completo de SPY ($n = 401$ días). ``Acierto'' es la fracción de direcciones correctas en los días en que el detector dispara; el P\&L de rescate es el acumulado de la intervención en esos días. PSA y GSO apenas disparan: su columna de acierto no aplica}{table.caption.21}{}}
\newlabel{tab:mp-detectores@cref}{{[table][1][5]5.1}{[1][26][]26}{}{}{}}
\newlabel{fig:mp-scores-detectores}{{5.3a}{27}{\emph {Scores} de RAM, PSA y GSO sobre el OOS de SPY, con su umbral de disparo (RAM $\tau = 0{,}50$, PSA $P_{95} = 0{,}023$, GSO $P_{95} = 2{,}371$). El de RAM es bimodal y cruza el umbral a menudo; los de PSA y GSO se acumulan muy por debajo del suyo}{figure.caption.22}{}}
\newlabel{fig:mp-scores-detectores@cref}{{[subfigure][1][5,3]5.3a}{[1][26][]27}{}{}{}}
\newlabel{sub@fig:mp-scores-detectores}{{a}{27}{\emph {Scores} de RAM, PSA y GSO sobre el OOS de SPY, con su umbral de disparo (RAM $\tau = 0{,}50$, PSA $P_{95} = 0{,}023$, GSO $P_{95} = 2{,}371$). El de RAM es bimodal y cruza el umbral a menudo; los de PSA y GSO se acumulan muy por debajo del suyo}{figure.caption.22}{}}
\newlabel{sub@fig:mp-scores-detectores@cref}{{[subfigure][1][5,3]5.3a}{[1][26][]27}{}{}{}}
\newlabel{fig:mp-confusion-spy}{{5.3b}{27}{Matriz de confusión de la intervención (M5 frente a M8), sobre las $121$ intervenciones. La diagonal de rescate ($71$ aciertos cuando el agente fallaba) supera a la de daño ($50$)}{figure.caption.22}{}}
\newlabel{fig:mp-confusion-spy@cref}{{[subfigure][2][5,3]5.3b}{[1][26][]27}{}{}{}}
\newlabel{sub@fig:mp-confusion-spy}{{b}{27}{Matriz de confusión de la intervención (M5 frente a M8), sobre las $121$ intervenciones. La diagonal de rescate ($71$ aciertos cuando el agente fallaba) supera a la de daño ($50$)}{figure.caption.22}{}}
\newlabel{sub@fig:mp-confusion-spy@cref}{{[subfigure][2][5,3]5.3b}{[1][26][]27}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.3}{\ignorespaces Disparo de los detectores y anatomía de la intervención sobre SPY.}}{27}{figure.caption.22}\protected@file@percent }
\newlabel{fig:mp-scores-confusion}{{5.3}{27}{Disparo de los detectores y anatomía de la intervención sobre SPY}{figure.caption.22}{}}
\newlabel{fig:mp-scores-confusion@cref}{{[figure][3][5]5.3}{[1][26][]27}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5.2}{\ignorespaces Modos de intervención de M8 sobre SPY (días en mercado, $n = 232$). El modo canónico (\emph  {override}) reorienta la posición al signo del régimen; las alternativas se abstienen o reducen el tamaño. En negrita, el modo adoptado.}}{27}{table.caption.23}\protected@file@percent }
\newlabel{tab:mp-variantes}{{5.2}{27}{Modos de intervención de M8 sobre SPY (días en mercado, $n = 232$). El modo canónico (\emph {override}) reorienta la posición al signo del régimen; las alternativas se abstienen o reducen el tamaño. En negrita, el modo adoptado}{table.caption.23}{}}
\newlabel{tab:mp-variantes@cref}{{[table][2][5]5.2}{[1][26][]27}{}{}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5.2}Comparación de las seis estrategias}{27}{section.5.2}\protected@file@percent }
\newlabel{sec:spy-estrategias}{{5.2}{27}{Comparación de las seis estrategias}{section.5.2}{}}
\newlabel{sec:spy-estrategias@cref}{{[section][2][5]5.2}{[1][27][]27}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5.3}{\ignorespaces Las seis estrategias sobre SPY, ventana desplegable ($n = 251$, \texttt  {signal\_lag}${}=1$). Accuracy direccional, Sharpe anualizado, máxima caída, ratio de Calmar \blx@tocontentsinit {0}\cite {young1991} y capital final por euro invertido. En negrita, la mejor en cada columna.}}{28}{table.caption.24}\protected@file@percent }
\newlabel{tab:mp-spy}{{5.3}{28}{Las seis estrategias sobre SPY, ventana desplegable ($n = 251$, \texttt {signal\_lag}${}=1$). Accuracy direccional, Sharpe anualizado, máxima caída, ratio de Calmar \cite {young1991} y capital final por euro invertido. En negrita, la mejor en cada columna}{table.caption.24}{}}
\newlabel{tab:mp-spy@cref}{{[table][3][5]5.3}{[1][27][]28}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.4}{\ignorespaces Curvas de capital de las seis estrategias sobre SPY (ventana desplegable, $n = 251$ días, un euro inicial). AutoML (línea destacada) supera a las dos referencias triviales en Sharpe ($+2{,}68$ frente a $+2{,}21$), en máxima caída ($-5{,}5\%$ frente a $-9{,}8\%$) y en capital final ($1{,}38\times $ frente a $1{,}30\times $); el agente solo (M5) termina en $0{,}70\times $. La ventaja sobre la trivial es nominal (McNemar AutoML vs ZeroR $p = 0{,}902$).}}{28}{figure.caption.25}\protected@file@percent }
\newlabel{fig:mp-equity-spy}{{5.4}{28}{Curvas de capital de las seis estrategias sobre SPY (ventana desplegable, $n = 251$ días, un euro inicial). AutoML (línea destacada) supera a las dos referencias triviales en Sharpe ($+2{,}68$ frente a $+2{,}21$), en máxima caída ($-5{,}5\%$ frente a $-9{,}8\%$) y en capital final ($1{,}38\times $ frente a $1{,}30\times $); el agente solo (M5) termina en $0{,}70\times $. La ventaja sobre la trivial es nominal (McNemar AutoML vs ZeroR $p = 0{,}902$)}{figure.caption.25}{}}
\newlabel{fig:mp-equity-spy@cref}{{[figure][4][5]5.4}{[1][28][]28}{}{}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5.3}El rescate sobre SPY}{28}{section.5.3}\protected@file@percent }
