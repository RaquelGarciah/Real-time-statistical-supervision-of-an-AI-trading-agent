\@writefile{toc}{\contentsline {section}{\numberline {B.1}Mecanismo sobre SPY}{54}{section.Alph2.1}\protected@file@percent }
\newlabel{anx:fig-spy}{{B.1}{54}{Mecanismo sobre SPY}{section.Alph2.1}{}}
\newlabel{anx:fig-spy@cref}{{[section][1][2]B.1}{[1][54][]54}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.1}{\ignorespaces Matriz régimen $\times $ dirección sobre SPY, en calibración y fuera de muestra. El régimen coincide con la caída del mismo día pero no anticipa el signo del siguiente: el \emph  {leverage} que explota RAM es contemporáneo, no predictivo.}}{54}{figure.caption.43}\protected@file@percent }
\newlabel{fig:anx-regimen-dir}{{B.1}{54}{Matriz régimen $\times $ dirección sobre SPY, en calibración y fuera de muestra. El régimen coincide con la caída del mismo día pero no anticipa el signo del siguiente: el \emph {leverage} que explota RAM es contemporáneo, no predictivo}{figure.caption.43}{}}
\newlabel{fig:anx-regimen-dir@cref}{{[figure][1][2]B.1}{[1][54][]54}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.2}{\ignorespaces Acierto del agente (M5) y del aprendiz (M10) por régimen, sobre SPY. El aprendiz corrige sobre todo donde el agente más se equivoca.}}{54}{figure.caption.44}\protected@file@percent }
\newlabel{fig:anx-confusion-m10}{{B.2}{54}{Acierto del agente (M5) y del aprendiz (M10) por régimen, sobre SPY. El aprendiz corrige sobre todo donde el agente más se equivoca}{figure.caption.44}{}}
\newlabel{fig:anx-confusion-m10@cref}{{[figure][2][2]B.2}{[1][54][]54}{}{}{}}
\@writefile{toc}{\contentsline {section}{\numberline {B.2}Panel de diez activos}{54}{section.Alph2.2}\protected@file@percent }
\newlabel{anx:fig-panel}{{B.2}{54}{Panel de diez activos}{section.Alph2.2}{}}
\newlabel{anx:fig-panel@cref}{{[section][2][2]B.2}{[1][54][]54}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.3}{\ignorespaces Robustez a la ventana de calibración: el rescate se mantiene al desplazar el periodo con el que se cierran los umbrales de los detectores. El resultado no cuelga de una calibración concreta.}}{55}{figure.caption.45}\protected@file@percent }
\newlabel{fig:mp-robustez-calib}{{B.3}{55}{Robustez a la ventana de calibración: el rescate se mantiene al desplazar el periodo con el que se cierran los umbrales de los detectores. El resultado no cuelga de una calibración concreta}{figure.caption.45}{}}
\newlabel{fig:mp-robustez-calib@cref}{{[figure][3][2]B.3}{[1][54][]55}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.4}{\ignorespaces Scores de PSA y GSO frente a su umbral ex ante, junto al sesgo casi constante del agente. Los dos detectores rara vez cruzan el umbral porque el agente apenas cambia de posición: están dormidos sobre este activo, no rotos.}}{55}{figure.caption.46}\protected@file@percent }
\newlabel{fig:anx-psa-gso}{{B.4}{55}{Scores de PSA y GSO frente a su umbral ex ante, junto al sesgo casi constante del agente. Los dos detectores rara vez cruzan el umbral porque el agente apenas cambia de posición: están dormidos sobre este activo, no rotos}{figure.caption.46}{}}
\newlabel{fig:anx-psa-gso@cref}{{[figure][4][2]B.4}{[1][54][]55}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.5}{\ignorespaces Dependencia SHAP de las señales de STRATA en el aprendiz: cómo cambia su contribución al variar cada \emph  {score}. El modelo no las usa de forma plana, las modula según el régimen.}}{55}{figure.caption.47}\protected@file@percent }
\newlabel{fig:anx-shap-dep}{{B.5}{55}{Dependencia SHAP de las señales de STRATA en el aprendiz: cómo cambia su contribución al variar cada \emph {score}. El modelo no las usa de forma plana, las modula según el régimen}{figure.caption.47}{}}
\newlabel{fig:anx-shap-dep@cref}{{[figure][5][2]B.5}{[1][54][]55}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.6}{\ignorespaces Cuota de importancia de las señales de STRATA a lo largo del tiempo, por reentreno. Se mantiene mayoritaria en toda la ventana: el aprendiz se apoya en STRATA de forma estable, no en un tramo afortunado.}}{55}{figure.caption.48}\protected@file@percent }
\newlabel{fig:anx-shap-rodante}{{B.6}{55}{Cuota de importancia de las señales de STRATA a lo largo del tiempo, por reentreno. Se mantiene mayoritaria en toda la ventana: el aprendiz se apoya en STRATA de forma estable, no en un tramo afortunado}{figure.caption.48}{}}
\newlabel{fig:anx-shap-rodante@cref}{{[figure][6][2]B.6}{[1][54][]55}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.7}{\ignorespaces Matrices de confusión de las seis estrategias sobre SPY, dirección predicha frente a la real. Enseñan de dónde sale el acierto de cada una, no solo su porcentaje: el agente carga el error en una clase y las derivadas de STRATA lo reparten mejor.}}{56}{figure.caption.49}\protected@file@percent }
\newlabel{fig:mp-confusion-spy6}{{B.7}{56}{Matrices de confusión de las seis estrategias sobre SPY, dirección predicha frente a la real. Enseñan de dónde sale el acierto de cada una, no solo su porcentaje: el agente carga el error en una clase y las derivadas de STRATA lo reparten mejor}{figure.caption.49}{}}
\newlabel{fig:mp-confusion-spy6@cref}{{[figure][7][2]B.7}{[1][54][]56}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.8}{\ignorespaces Sensibilidad de la accuracy al umbral de decisión sobre SPY: M8 frente a $\tau $ del detector RAM y M10 frente a su umbral de probabilidad. Las dos curvas son planas en una meseta alrededor del valor canónico (marcado), señal de robustez y no de ajuste a un punto.}}{56}{figure.caption.50}\protected@file@percent }
\newlabel{fig:mp-sensibilidad}{{B.8}{56}{Sensibilidad de la accuracy al umbral de decisión sobre SPY: M8 frente a $\tau $ del detector RAM y M10 frente a su umbral de probabilidad. Las dos curvas son planas en una meseta alrededor del valor canónico (marcado), señal de robustez y no de ajuste a un punto}{figure.caption.50}{}}
\newlabel{fig:mp-sensibilidad@cref}{{[figure][8][2]B.8}{[1][54][]56}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.9}{\ignorespaces $p$ de McNemar del rescate frente al agente, por estrategia y régimen, con el nivel $\alpha = 0{,}10$ marcado. El rescate en acierto es significativo en los dos regímenes.}}{56}{figure.caption.51}\protected@file@percent }
\newlabel{fig:anx-mcnemar}{{B.9}{56}{$p$ de McNemar del rescate frente al agente, por estrategia y régimen, con el nivel $\alpha = 0{,}10$ marcado. El rescate en acierto es significativo en los dos regímenes}{figure.caption.51}{}}
\newlabel{fig:anx-mcnemar@cref}{{[figure][9][2]B.9}{[1][54][]56}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.10}{\ignorespaces Dos casos trabajados, uno por canal. A la izquierda, XLE (\emph  {leverage} fuerte): el régimen es direccional y la regla rescata el riesgo del agente. A la derecha, MARA (\emph  {leverage} invertido): el régimen no informa el signo y el aprendiz rescata por la vía del sesgo del agente cruzado con el régimen. Cada panel muestra la dirección del agente, la del supervisor que rescata y el régimen vigente.}}{57}{figure.caption.52}\protected@file@percent }
\newlabel{fig:mp-casos}{{B.10}{57}{Dos casos trabajados, uno por canal. A la izquierda, XLE (\emph {leverage} fuerte): el régimen es direccional y la regla rescata el riesgo del agente. A la derecha, MARA (\emph {leverage} invertido): el régimen no informa el signo y el aprendiz rescata por la vía del sesgo del agente cruzado con el régimen. Cada panel muestra la dirección del agente, la del supervisor que rescata y el régimen vigente}{figure.caption.52}{}}
\newlabel{fig:mp-casos@cref}{{[figure][10][2]B.10}{[1][54][]57}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.11}{\ignorespaces Diagrama $2\times 2$ del TOST del aprendiz frente a la regla M8, ejes accuracy (horizontal) y Sharpe (vertical). Las regiones marcan superioridad, equivalencia y no concluyencia. M10 y AutoML caen en superioridad en accuracy y en no concluyencia en Sharpe: el aprendiz afina la dirección sobre la regla y empata en riesgo.}}{57}{figure.caption.53}\protected@file@percent }
\newlabel{fig:mp-tost}{{B.11}{57}{Diagrama $2\times 2$ del TOST del aprendiz frente a la regla M8, ejes accuracy (horizontal) y Sharpe (vertical). Las regiones marcan superioridad, equivalencia y no concluyencia. M10 y AutoML caen en superioridad en accuracy y en no concluyencia en Sharpe: el aprendiz afina la dirección sobre la regla y empata en riesgo}{figure.caption.53}{}}
\newlabel{fig:mp-tost@cref}{{[figure][11][2]B.11}{[1][54][]57}{}{}{}}
