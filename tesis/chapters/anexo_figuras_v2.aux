\@writefile{toc}{\contentsline {section}{\numberline {B.1}Mecanismo sobre SPY}{53}{section.Alph2.1}\protected@file@percent }
\newlabel{anx:fig-spy}{{B.1}{53}{Mecanismo sobre SPY}{section.Alph2.1}{}}
\newlabel{anx:fig-spy@cref}{{[section][1][2]B.1}{[1][53][]53}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.1}{\ignorespaces Matriz régimen $\times $ dirección sobre SPY, en calibración y fuera de muestra. El régimen coincide con la caída del mismo día, pero no anticipa el signo del siguiente: el \emph  {leverage} que explota RAM es contemporáneo, no predictivo.}}{53}{figure.Alph2.1}\protected@file@percent }
\newlabel{fig:anx-regimen-dir}{{B.1}{53}{Matriz régimen $\times $ dirección sobre SPY, en calibración y fuera de muestra. El régimen coincide con la caída del mismo día, pero no anticipa el signo del siguiente: el \emph {leverage} que explota RAM es contemporáneo, no predictivo}{figure.Alph2.1}{}}
\newlabel{fig:anx-regimen-dir@cref}{{[figure][1][2]B.1}{[1][53][]53}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.2}{\ignorespaces Scores de PSA y GSO frente a su umbral ex ante, junto al sesgo casi constante del agente. Los dos detectores rara vez cruzan el umbral porque el agente apenas cambia de posición: están dormidos sobre este activo, no rotos.}}{53}{figure.Alph2.2}\protected@file@percent }
\newlabel{fig:anx-psa-gso}{{B.2}{53}{Scores de PSA y GSO frente a su umbral ex ante, junto al sesgo casi constante del agente. Los dos detectores rara vez cruzan el umbral porque el agente apenas cambia de posición: están dormidos sobre este activo, no rotos}{figure.Alph2.2}{}}
\newlabel{fig:anx-psa-gso@cref}{{[figure][2][2]B.2}{[1][53][]53}{}{}{}}
\@writefile{toc}{\contentsline {section}{\numberline {B.2}Panel de diez activos}{53}{section.Alph2.2}\protected@file@percent }
\newlabel{anx:fig-panel}{{B.2}{53}{Panel de diez activos}{section.Alph2.2}{}}
\newlabel{anx:fig-panel@cref}{{[section][2][2]B.2}{[1][53][]53}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.3}{\ignorespaces Dependencia SHAP de las señales de STRATA en el aprendiz: cómo cambia su contribución al variar cada \emph  {score}. El modelo no las usa de forma plana, las modula según el régimen.}}{54}{figure.Alph2.3}\protected@file@percent }
\newlabel{fig:anx-shap-dep}{{B.3}{54}{Dependencia SHAP de las señales de STRATA en el aprendiz: cómo cambia su contribución al variar cada \emph {score}. El modelo no las usa de forma plana, las modula según el régimen}{figure.Alph2.3}{}}
\newlabel{fig:anx-shap-dep@cref}{{[figure][3][2]B.3}{[1][53][]54}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.4}{\ignorespaces Cuota de importancia de las señales de STRATA a lo largo del tiempo, por reentreno. Se mantiene mayoritaria en toda la ventana: el aprendiz se apoya en STRATA de forma estable, no en un tramo afortunado.}}{54}{figure.Alph2.4}\protected@file@percent }
\newlabel{fig:anx-shap-rodante}{{B.4}{54}{Cuota de importancia de las señales de STRATA a lo largo del tiempo, por reentreno. Se mantiene mayoritaria en toda la ventana: el aprendiz se apoya en STRATA de forma estable, no en un tramo afortunado}{figure.Alph2.4}{}}
\newlabel{fig:anx-shap-rodante@cref}{{[figure][4][2]B.4}{[1][53][]54}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.5}{\ignorespaces Acierto del agente (M5) y del aprendiz (M10) por régimen, sobre SPY. El aprendiz corrige sobre todo donde el agente más se equivoca.}}{54}{figure.Alph2.5}\protected@file@percent }
\newlabel{fig:anx-confusion-m10}{{B.5}{54}{Acierto del agente (M5) y del aprendiz (M10) por régimen, sobre SPY. El aprendiz corrige sobre todo donde el agente más se equivoca}{figure.Alph2.5}{}}
\newlabel{fig:anx-confusion-m10@cref}{{[figure][5][2]B.5}{[1][53][]54}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.6}{\ignorespaces Matrices de confusión de la mejor derivada de STRATA en cada activo. Enseñan el reparto de aciertos y fallos detrás de cada accuracy del panel.}}{55}{figure.Alph2.6}\protected@file@percent }
\newlabel{fig:anx-confusion-panel}{{B.6}{55}{Matrices de confusión de la mejor derivada de STRATA en cada activo. Enseñan el reparto de aciertos y fallos detrás de cada accuracy del panel}{figure.Alph2.6}{}}
\newlabel{fig:anx-confusion-panel@cref}{{[figure][6][2]B.6}{[1][53][]55}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.7}{\ignorespaces Contraste de diferencia en diferencias de la complementariedad por régimen: $\Delta \Delta $Sharpe \emph  {pooled-10} de M10 frente a AutoML entre mercado alcista y bajista, con su intervalo al $95\%$. El intervalo excluye el cero ($+1{,}37$, $p = 0{,}008$): la complementariedad es significativa sobre el panel, no en SPY solo.}}{55}{figure.Alph2.7}\protected@file@percent }
\newlabel{fig:anx-did}{{B.7}{55}{Contraste de diferencia en diferencias de la complementariedad por régimen: $\Delta \Delta $Sharpe \emph {pooled-10} de M10 frente a AutoML entre mercado alcista y bajista, con su intervalo al $95\%$. El intervalo excluye el cero ($+1{,}37$, $p = 0{,}008$): la complementariedad es significativa sobre el panel, no en SPY solo}{figure.Alph2.7}{}}
\newlabel{fig:anx-did@cref}{{[figure][7][2]B.7}{[1][53][]55}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.8}{\ignorespaces $p$ de McNemar del rescate frente al agente, por estrategia y régimen, con el nivel $\alpha = 0{,}10$ marcado. El rescate en acierto es significativo en los dos regímenes.}}{55}{figure.Alph2.8}\protected@file@percent }
\newlabel{fig:anx-mcnemar}{{B.8}{55}{$p$ de McNemar del rescate frente al agente, por estrategia y régimen, con el nivel $\alpha = 0{,}10$ marcado. El rescate en acierto es significativo en los dos regímenes}{figure.Alph2.8}{}}
\newlabel{fig:anx-mcnemar@cref}{{[figure][8][2]B.8}{[1][53][]55}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.9}{\ignorespaces Accuracy y Sharpe medios por estrategia dentro de cada grupo del clustering. Cada grupo se rescata por un canal distinto, coherente con su naturaleza.}}{56}{figure.Alph2.9}\protected@file@percent }
\newlabel{fig:anx-grupos}{{B.9}{56}{Accuracy y Sharpe medios por estrategia dentro de cada grupo del clustering. Cada grupo se rescata por un canal distinto, coherente con su naturaleza}{figure.Alph2.9}{}}
\newlabel{fig:anx-grupos@cref}{{[figure][9][2]B.9}{[1][53][]56}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.10}{\ignorespaces Distribución de los \emph  {scores} de RAM, PSA y GSO sobre el OOS de SPY, con su umbral de disparo marcado (RAM $\tau = 0{,}50$, PSA $P_{95} = 0{,}023$, GSO $P_{95} = 2{,}371$). El \emph  {score} de RAM es bimodal y cruza el umbral con frecuencia; los de PSA y GSO se acumulan muy por debajo del suyo, de ahí que apenas disparen.}}{56}{figure.Alph2.10}\protected@file@percent }
\newlabel{fig:mp-scores-detectores}{{B.10}{56}{Distribución de los \emph {scores} de RAM, PSA y GSO sobre el OOS de SPY, con su umbral de disparo marcado (RAM $\tau = 0{,}50$, PSA $P_{95} = 0{,}023$, GSO $P_{95} = 2{,}371$). El \emph {score} de RAM es bimodal y cruza el umbral con frecuencia; los de PSA y GSO se acumulan muy por debajo del suyo, de ahí que apenas disparen}{figure.Alph2.10}{}}
\newlabel{fig:mp-scores-detectores@cref}{{[figure][10][2]B.10}{[1][53][]56}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.11}{\ignorespaces Matriz de confusión de la intervención sobre SPY: dirección del agente (M5) frente a dirección tras intervenir (M8), sobre las $121$ intervenciones. La diagonal de rescate ($71$ aciertos de la intervención cuando el agente fallaba) supera a la de daño ($50$).}}{57}{figure.Alph2.11}\protected@file@percent }
\newlabel{fig:mp-confusion-spy}{{B.11}{57}{Matriz de confusión de la intervención sobre SPY: dirección del agente (M5) frente a dirección tras intervenir (M8), sobre las $121$ intervenciones. La diagonal de rescate ($71$ aciertos de la intervención cuando el agente fallaba) supera a la de daño ($50$)}{figure.Alph2.11}{}}
\newlabel{fig:mp-confusion-spy@cref}{{[figure][11][2]B.11}{[1][53][]57}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.12}{\ignorespaces Sensibilidad de la accuracy al umbral de decisión sobre SPY: M8 frente a $\tau $ del detector RAM y M10 frente a su umbral de probabilidad. Las dos curvas son planas en una meseta alrededor del valor canónico (marcado), señal de robustez y no de ajuste a un punto.}}{57}{figure.Alph2.12}\protected@file@percent }
\newlabel{fig:mp-sensibilidad}{{B.12}{57}{Sensibilidad de la accuracy al umbral de decisión sobre SPY: M8 frente a $\tau $ del detector RAM y M10 frente a su umbral de probabilidad. Las dos curvas son planas en una meseta alrededor del valor canónico (marcado), señal de robustez y no de ajuste a un punto}{figure.Alph2.12}{}}
\newlabel{fig:mp-sensibilidad@cref}{{[figure][12][2]B.12}{[1][53][]57}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.13}{\ignorespaces Tasa de disparo de RAM, PSA y GSO y tasa de intervención de la regla, activo a activo. RAM domina en todo el panel y los otros dos apenas se encienden: la supervisión recae, como en SPY, sobre el canal del régimen.}}{57}{figure.Alph2.13}\protected@file@percent }
\newlabel{fig:mp-activacion-panel}{{B.13}{57}{Tasa de disparo de RAM, PSA y GSO y tasa de intervención de la regla, activo a activo. RAM domina en todo el panel y los otros dos apenas se encienden: la supervisión recae, como en SPY, sobre el canal del régimen}{figure.Alph2.13}{}}
\newlabel{fig:mp-activacion-panel@cref}{{[figure][13][2]B.13}{[1][53][]57}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.14}{\ignorespaces Curvas de capital por activo (un euro inicial), con la mejor derivada de STRATA destacada frente a las referencias. En cuatro activos una derivada supera al pasivo en Sharpe: SPY, SMCI, MARA y UNG. En SMCI/MARA/UNG el pasivo pierde o ronda el cero y la derivada obtiene Sharpe positivo al posicionarse de forma defensiva; en SPY la ventaja es sobre todo beta de mercado en un periodo alcista. }}{58}{figure.Alph2.14}\protected@file@percent }
\newlabel{fig:mp-equity-panel}{{B.14}{58}{Curvas de capital por activo (un euro inicial), con la mejor derivada de STRATA destacada frente a las referencias. En cuatro activos una derivada supera al pasivo en Sharpe: SPY, SMCI, MARA y UNG. En SMCI/MARA/UNG el pasivo pierde o ronda el cero y la derivada obtiene Sharpe positivo al posicionarse de forma defensiva; en SPY la ventaja es sobre todo beta de mercado en un periodo alcista}{figure.Alph2.14}{}}
\newlabel{fig:mp-equity-panel@cref}{{[figure][14][2]B.14}{[1][53][]58}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.15}{\ignorespaces Reparto de funciones entre las dos capas. A la izquierda, atribución del P\&L de rescate por detector sobre SPY: el canal de régimen (RAM) concentra el $100\%$, PSA y GSO aportan cero. A la derecha, evolución diaria del rescate de la regla (riesgo, $\Delta $Sharpe acumulado) frente al del aprendiz (accuracy, aciertos acumulados sobre el agente): cada serie sube por un eje distinto.}}{58}{figure.Alph2.15}\protected@file@percent }
\newlabel{fig:mp-capas}{{B.15}{58}{Reparto de funciones entre las dos capas. A la izquierda, atribución del P\&L de rescate por detector sobre SPY: el canal de régimen (RAM) concentra el $100\%$, PSA y GSO aportan cero. A la derecha, evolución diaria del rescate de la regla (riesgo, $\Delta $Sharpe acumulado) frente al del aprendiz (accuracy, aciertos acumulados sobre el agente): cada serie sube por un eje distinto}{figure.Alph2.15}{}}
\newlabel{fig:mp-capas@cref}{{[figure][15][2]B.15}{[1][53][]58}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.16}{\ignorespaces Naturaleza de los diez activos en cuatro rasgos: \emph  {leverage} de Black, fracción de días en Crisis, sesgo direccional del agente y volatilidad. Es la materia prima de la ley del \emph  {leverage} y del agrupamiento: esa heterogeneidad es la que ordena el rescate.}}{58}{figure.Alph2.16}\protected@file@percent }
\newlabel{fig:mp-naturaleza}{{B.16}{58}{Naturaleza de los diez activos en cuatro rasgos: \emph {leverage} de Black, fracción de días en Crisis, sesgo direccional del agente y volatilidad. Es la materia prima de la ley del \emph {leverage} y del agrupamiento: esa heterogeneidad es la que ordena el rescate}{figure.Alph2.16}{}}
\newlabel{fig:mp-naturaleza@cref}{{[figure][16][2]B.16}{[1][53][]58}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.17}{\ignorespaces Dos casos trabajados, uno por canal. A la izquierda, XLE (\emph  {leverage} fuerte): el régimen es direccional y la regla rescata el riesgo del agente. A la derecha, MARA (\emph  {leverage} invertido): el régimen no informa el signo y el aprendiz rescata por la vía del sesgo del agente cruzado con el régimen. Cada panel muestra la dirección del agente, la del supervisor que rescata y el régimen vigente.}}{59}{figure.Alph2.17}\protected@file@percent }
\newlabel{fig:mp-casos}{{B.17}{59}{Dos casos trabajados, uno por canal. A la izquierda, XLE (\emph {leverage} fuerte): el régimen es direccional y la regla rescata el riesgo del agente. A la derecha, MARA (\emph {leverage} invertido): el régimen no informa el signo y el aprendiz rescata por la vía del sesgo del agente cruzado con el régimen. Cada panel muestra la dirección del agente, la del supervisor que rescata y el régimen vigente}{figure.Alph2.17}{}}
\newlabel{fig:mp-casos@cref}{{[figure][17][2]B.17}{[1][53][]59}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.18}{\ignorespaces Robustez a la ventana de calibración: el rescate se mantiene al desplazar el periodo con el que se cierran los umbrales de los detectores. El resultado no cuelga de una calibración concreta.}}{59}{figure.Alph2.18}\protected@file@percent }
\newlabel{fig:mp-robustez-calib}{{B.18}{59}{Robustez a la ventana de calibración: el rescate se mantiene al desplazar el periodo con el que se cierran los umbrales de los detectores. El resultado no cuelga de una calibración concreta}{figure.Alph2.18}{}}
\newlabel{fig:mp-robustez-calib@cref}{{[figure][18][2]B.18}{[1][53][]59}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.19}{\ignorespaces Robustez del rescate en el panel por tres vías: cuota de importancia rodante en el tiempo, fracción de ventanas con rescate por activo y McNemar partido por régimen. El rescate aguanta en las tres, no es un artefacto de una ventana ni de un régimen.}}{59}{figure.Alph2.19}\protected@file@percent }
\newlabel{fig:mp-robustez-panel}{{B.19}{59}{Robustez del rescate en el panel por tres vías: cuota de importancia rodante en el tiempo, fracción de ventanas con rescate por activo y McNemar partido por régimen. El rescate aguanta en las tres, no es un artefacto de una ventana ni de un régimen}{figure.Alph2.19}{}}
\newlabel{fig:mp-robustez-panel@cref}{{[figure][19][2]B.19}{[1][53][]59}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.20}{\ignorespaces Diagrama $2\times 2$ del TOST del aprendiz frente a la regla M8, ejes accuracy (horizontal) y Sharpe (vertical). Las regiones marcan superioridad, equivalencia y no concluyencia. M10 y AutoML caen en superioridad en accuracy y en no concluyencia en Sharpe: el aprendiz afina la dirección sobre la regla y empata en riesgo.}}{60}{figure.Alph2.20}\protected@file@percent }
\newlabel{fig:mp-tost}{{B.20}{60}{Diagrama $2\times 2$ del TOST del aprendiz frente a la regla M8, ejes accuracy (horizontal) y Sharpe (vertical). Las regiones marcan superioridad, equivalencia y no concluyencia. M10 y AutoML caen en superioridad en accuracy y en no concluyencia en Sharpe: el aprendiz afina la dirección sobre la regla y empata en riesgo}{figure.Alph2.20}{}}
\newlabel{fig:mp-tost@cref}{{[figure][20][2]B.20}{[1][53][]60}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.21}{\ignorespaces Complementariedad de los supervisores por régimen: $\Delta $Sharpe de M8, M10 y AutoML frente al agente, en mercado alcista y bajista. M10 rescata más en alcista, AutoML más en bajista. El contraste formal de ese reparto (diferencia en diferencias, $\Delta \Delta $Sharpe $= +1{,}37$, $p = 0{,}008$) está en la Figura~\ref {fig:anx-did}.}}{60}{figure.Alph2.21}\protected@file@percent }
\newlabel{fig:mp-did}{{B.21}{60}{Complementariedad de los supervisores por régimen: $\Delta $Sharpe de M8, M10 y AutoML frente al agente, en mercado alcista y bajista. M10 rescata más en alcista, AutoML más en bajista. El contraste formal de ese reparto (diferencia en diferencias, $\Delta \Delta $Sharpe $= +1{,}37$, $p = 0{,}008$) está en la Figura~\ref {fig:anx-did}}{figure.Alph2.21}{}}
\newlabel{fig:mp-did@cref}{{[figure][21][2]B.21}{[1][53][]60}{}{}{}}
