\@writefile{toc}{\contentsline {section}{\numberline {B.1}Mecanismo sobre SPY}{75}{section.Alph2.1}\protected@file@percent }
\newlabel{anx:fig-spy}{{B.1}{75}{Mecanismo sobre SPY}{section.Alph2.1}{}}
\newlabel{anx:fig-spy@cref}{{[section][1][2]B.1}{[1][75][]75}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.1}{\ignorespaces Matriz régimen $\times $ dirección sobre SPY, en calibración y fuera de muestra. El régimen coincide con la caída del mismo día, pero no anticipa el signo del siguiente: el \emph  {leverage} que explota RAM es contemporáneo, no predictivo.}}{75}{figure.Alph2.1}\protected@file@percent }
\newlabel{fig:anx-regimen-dir}{{B.1}{75}{Matriz régimen $\times $ dirección sobre SPY, en calibración y fuera de muestra. El régimen coincide con la caída del mismo día, pero no anticipa el signo del siguiente: el \emph {leverage} que explota RAM es contemporáneo, no predictivo}{figure.Alph2.1}{}}
\newlabel{fig:anx-regimen-dir@cref}{{[figure][1][2]B.1}{[1][75][]75}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.2}{\ignorespaces Scores de PSA y GSO frente a su umbral ex ante, junto al sesgo casi constante del agente. Los dos detectores rara vez cruzan el umbral porque el agente apenas cambia de posición: están dormidos sobre este activo, no rotos.}}{75}{figure.Alph2.2}\protected@file@percent }
\newlabel{fig:anx-psa-gso}{{B.2}{75}{Scores de PSA y GSO frente a su umbral ex ante, junto al sesgo casi constante del agente. Los dos detectores rara vez cruzan el umbral porque el agente apenas cambia de posición: están dormidos sobre este activo, no rotos}{figure.Alph2.2}{}}
\newlabel{fig:anx-psa-gso@cref}{{[figure][2][2]B.2}{[1][75][]75}{}{}{}}
\@writefile{toc}{\contentsline {section}{\numberline {B.2}Panel de diez activos}{75}{section.Alph2.2}\protected@file@percent }
\newlabel{anx:fig-panel}{{B.2}{75}{Panel de diez activos}{section.Alph2.2}{}}
\newlabel{anx:fig-panel@cref}{{[section][2][2]B.2}{[1][75][]75}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.3}{\ignorespaces Dependencia SHAP de las señales de STRATA en el aprendiz: cómo cambia su contribución al variar cada \emph  {score}. El modelo no las usa de forma plana, las modula según el régimen.}}{76}{figure.Alph2.3}\protected@file@percent }
\newlabel{fig:anx-shap-dep}{{B.3}{76}{Dependencia SHAP de las señales de STRATA en el aprendiz: cómo cambia su contribución al variar cada \emph {score}. El modelo no las usa de forma plana, las modula según el régimen}{figure.Alph2.3}{}}
\newlabel{fig:anx-shap-dep@cref}{{[figure][3][2]B.3}{[1][75][]76}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.4}{\ignorespaces Cuota de importancia de las señales de STRATA a lo largo del tiempo, por reentreno. Se mantiene mayoritaria en toda la ventana: el aprendiz se apoya en STRATA de forma estable, no en un tramo afortunado.}}{76}{figure.Alph2.4}\protected@file@percent }
\newlabel{fig:anx-shap-rodante}{{B.4}{76}{Cuota de importancia de las señales de STRATA a lo largo del tiempo, por reentreno. Se mantiene mayoritaria en toda la ventana: el aprendiz se apoya en STRATA de forma estable, no en un tramo afortunado}{figure.Alph2.4}{}}
\newlabel{fig:anx-shap-rodante@cref}{{[figure][4][2]B.4}{[1][75][]76}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.5}{\ignorespaces Acierto del agente (M5) y del aprendiz (M10) por régimen, sobre SPY. El aprendiz corrige sobre todo donde el agente más se equivoca.}}{76}{figure.Alph2.5}\protected@file@percent }
\newlabel{fig:anx-confusion-m10}{{B.5}{76}{Acierto del agente (M5) y del aprendiz (M10) por régimen, sobre SPY. El aprendiz corrige sobre todo donde el agente más se equivoca}{figure.Alph2.5}{}}
\newlabel{fig:anx-confusion-m10@cref}{{[figure][5][2]B.5}{[1][75][]76}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.6}{\ignorespaces Matrices de confusión de la mejor derivada de STRATA en cada activo. Enseñan el reparto de aciertos y fallos detrás de cada accuracy del panel.}}{77}{figure.Alph2.6}\protected@file@percent }
\newlabel{fig:anx-confusion-panel}{{B.6}{77}{Matrices de confusión de la mejor derivada de STRATA en cada activo. Enseñan el reparto de aciertos y fallos detrás de cada accuracy del panel}{figure.Alph2.6}{}}
\newlabel{fig:anx-confusion-panel@cref}{{[figure][6][2]B.6}{[1][75][]77}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.7}{\ignorespaces Contraste de diferencia en diferencias de la complementariedad por régimen: $\Delta \Delta $Sharpe \emph  {pooled-10} de M10 frente a AutoML entre mercado alcista y bajista, con su intervalo al $95\%$. El intervalo excluye el cero ($+1{,}37$, $p = 0{,}008$): la complementariedad es significativa sobre el panel, no en SPY solo.}}{77}{figure.Alph2.7}\protected@file@percent }
\newlabel{fig:anx-did}{{B.7}{77}{Contraste de diferencia en diferencias de la complementariedad por régimen: $\Delta \Delta $Sharpe \emph {pooled-10} de M10 frente a AutoML entre mercado alcista y bajista, con su intervalo al $95\%$. El intervalo excluye el cero ($+1{,}37$, $p = 0{,}008$): la complementariedad es significativa sobre el panel, no en SPY solo}{figure.Alph2.7}{}}
\newlabel{fig:anx-did@cref}{{[figure][7][2]B.7}{[1][75][]77}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.8}{\ignorespaces $p$ de McNemar del rescate frente al agente, por estrategia y régimen, con el nivel $\alpha = 0{,}10$ marcado. El rescate en acierto es significativo en los dos regímenes.}}{77}{figure.Alph2.8}\protected@file@percent }
\newlabel{fig:anx-mcnemar}{{B.8}{77}{$p$ de McNemar del rescate frente al agente, por estrategia y régimen, con el nivel $\alpha = 0{,}10$ marcado. El rescate en acierto es significativo en los dos regímenes}{figure.Alph2.8}{}}
\newlabel{fig:anx-mcnemar@cref}{{[figure][8][2]B.8}{[1][75][]77}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B.9}{\ignorespaces Accuracy y Sharpe medios por estrategia dentro de cada grupo del clustering. Cada grupo se rescata por un canal distinto, coherente con su naturaleza.}}{78}{figure.Alph2.9}\protected@file@percent }
\newlabel{fig:anx-grupos}{{B.9}{78}{Accuracy y Sharpe medios por estrategia dentro de cada grupo del clustering. Cada grupo se rescata por un canal distinto, coherente con su naturaleza}{figure.Alph2.9}{}}
\newlabel{fig:anx-grupos@cref}{{[figure][9][2]B.9}{[1][75][]78}{}{}{}}
