\newlabel{sec:panel-pooled@cref}{{[subsection][3][6,1]6.1.3}{[1][31][]31}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6.3}{\ignorespaces Rescate en riesgo agregado (\emph  {pooled-10}, $n = 2493$ días): $\Delta $Sharpe de cada estrategia supervisada frente al agente M5, con intervalo de confianza al $95\%$ por \emph  {bootstrap} estacionario de bloque medio $\sqrt  {n}$ (Politis y Romano 1994). Los tres intervalos excluyen el cero.}}{32}{table.6.3}\protected@file@percent }
\newlabel{tab:mp-pooled}{{6.3}{32}{Rescate en riesgo agregado (\emph {pooled-10}, $n = 2493$ días): $\Delta $Sharpe de cada estrategia supervisada frente al agente M5, con intervalo de confianza al $95\%$ por \emph {bootstrap} estacionario de bloque medio $\sqrt {n}$ (Politis y Romano 1994). Los tres intervalos excluyen el cero}{table.6.3}{}}
\newlabel{tab:mp-pooled@cref}{{[table][3][6]6.3}{[1][31][]32}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6.3}{\ignorespaces Diagrama de bosque del $\Delta $Sharpe \emph  {pooled-10} frente al agente M5, con intervalo al $95\%$ (\emph  {bootstrap} estacionario, Politis y Romano 1994). La línea vertical marca el cero. Los tres intervalos excluyen el cero; la regla M8 con el límite inferior más cerca del borde y los aprendices M10 y AutoML con más holgura.}}{32}{figure.6.3}\protected@file@percent }
\newlabel{fig:mp-forest}{{6.3}{32}{Diagrama de bosque del $\Delta $Sharpe \emph {pooled-10} frente al agente M5, con intervalo al $95\%$ (\emph {bootstrap} estacionario, Politis y Romano 1994). La línea vertical marca el cero. Los tres intervalos excluyen el cero; la regla M8 con el límite inferior más cerca del borde y los aprendices M10 y AutoML con más holgura}{figure.6.3}{}}
\newlabel{fig:mp-forest@cref}{{[figure][3][6]6.3}{[1][31][]32}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.1.4}Equivalencia: el aprendiz recupera STRATA y supera a la regla}{32}{subsection.6.1.4}\protected@file@percent }
\newlabel{sec:panel-tost}{{6.1.4}{32}{Equivalencia: el aprendiz recupera STRATA y supera a la regla}{subsection.6.1.4}{}}
\newlabel{sec:panel-tost@cref}{{[subsection][4][6,1]6.1.4}{[1][32][]32}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6.4}{\ignorespaces TOST del aprendiz frente a la regla M8 (Schuirmann 1987) y cuota de Shapley de las features de STRATA por activo (Lundberg y Lee 2017). En accuracy el aprendiz supera a la regla (intervalo al $90\%$ por encima de cero); en Sharpe el test es no concluyente (indistinguibles). La cuota SHAP de STRATA supera $0{,}5$ en los diez activos.}}{33}{table.6.4}\protected@file@percent }
\newlabel{tab:mp-tost}{{6.4}{33}{TOST del aprendiz frente a la regla M8 (Schuirmann 1987) y cuota de Shapley de las features de STRATA por activo (Lundberg y Lee 2017). En accuracy el aprendiz supera a la regla (intervalo al $90\%$ por encima de cero); en Sharpe el test es no concluyente (indistinguibles). La cuota SHAP de STRATA supera $0{,}5$ en los diez activos}{table.6.4}{}}
\newlabel{tab:mp-tost@cref}{{[table][4][6]6.4}{[1][33][]33}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6.5}{\ignorespaces Atribución por capa sobre el panel de diez activos. La regla (M8) aporta el rescate de riesgo, con todo su P\&L de intervención concentrado en el canal de régimen (RAM, Figura~\ref {fig:mp-capas}); nunca lidera en accuracy. El aprendiz (M10/AutoML) aporta el rescate de accuracy y no lidera el riesgo en exclusiva. El capital final es sobre la ventana desplegable de SPY partiendo de un euro; el agente solo termina en $0{,}70\times $. $\Delta $Sharpe pooled frente al agente, IC$_{95}$ por bootstrap estacionario.}}{33}{table.6.5}\protected@file@percent }
\newlabel{tab:mp-capas}{{6.5}{33}{Atribución por capa sobre el panel de diez activos. La regla (M8) aporta el rescate de riesgo, con todo su P\&L de intervención concentrado en el canal de régimen (RAM, Figura~\ref {fig:mp-capas}); nunca lidera en accuracy. El aprendiz (M10/AutoML) aporta el rescate de accuracy y no lidera el riesgo en exclusiva. El capital final es sobre la ventana desplegable de SPY partiendo de un euro; el agente solo termina en $0{,}70\times $. $\Delta $Sharpe pooled frente al agente, IC$_{95}$ por bootstrap estacionario}{table.6.5}{}}
\newlabel{tab:mp-capas@cref}{{[table][5][6]6.5}{[1][33][]33}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.1.5}Complementariedad por régimen}{33}{subsection.6.1.5}\protected@file@percent }
\newlabel{sec:panel-regimen}{{6.1.5}{33}{Complementariedad por régimen}{subsection.6.1.5}{}}
\newlabel{sec:panel-regimen@cref}{{[subsection][5][6,1]6.1.5}{[1][33][]33}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6.6}{\ignorespaces Rescate por régimen (McNemar pooled de la estrategia superior frente a M5, $p$ corregido por Holm 1979) y complementariedad de los aprendices (DiD). El rescate es significativo en alcista y en bajista. El DiD contrasta el $\Delta \Delta $Sharpe entre aprendices y regímenes: M10 rescata más en alcista, AutoML más en bajista.}}{34}{table.6.6}\protected@file@percent }
\newlabel{tab:mp-regimen}{{6.6}{34}{Rescate por régimen (McNemar pooled de la estrategia superior frente a M5, $p$ corregido por Holm 1979) y complementariedad de los aprendices (DiD). El rescate es significativo en alcista y en bajista. El DiD contrasta el $\Delta \Delta $Sharpe entre aprendices y regímenes: M10 rescata más en alcista, AutoML más en bajista}{table.6.6}{}}
