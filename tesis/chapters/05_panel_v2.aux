\newlabel{sec:panel-patron@cref}{{[section][2][6]6.2}{[1][34][]34}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.2.1}La ley del \emph  {leverage}}{34}{subsection.6.2.1}\protected@file@percent }
\newlabel{sec:panel-ley}{{6.2.1}{34}{La ley del \emph {leverage}}{subsection.6.2.1}{}}
\newlabel{sec:panel-ley@cref}{{[subsection][1][6,2]6.2.1}{[1][34][]34}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.2.2}Clustering: la naturaleza separa los grupos}{34}{subsection.6.2.2}\protected@file@percent }
\newlabel{sec:panel-clustering}{{6.2.2}{34}{Clustering: la naturaleza separa los grupos}{subsection.6.2.2}{}}
\newlabel{sec:panel-clustering@cref}{{[subsection][2][6,2]6.2.2}{[1][34][]34}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6.7}{\ignorespaces Ley del \emph  {leverage}: correlación de Black y rescate del aprendiz por activo (panel de diez), ordenados por \emph  {leverage} creciente. Rescate ${}= \mathop {\mathgroup \symoperators m\acute  {a}x}(\mathrm  {M10},\mathrm  {AutoML}) - \mathrm  {M5}$ en accuracy. Nueve de los diez siguen la tendencia (a más \emph  {leverage} negativo, más rescate); ROKU es la excepción. Sobre los diez: Pearson $r = -0{,}56$ ($p = 0{,}093$), Spearman $\rho = -0{,}59$ ($p = 0{,}074$); tendencia significativa al $\alpha = 0{,}10$ pre-registrado.}}{35}{table.6.7}\protected@file@percent }
\newlabel{tab:mp-ley}{{6.7}{35}{Ley del \emph {leverage}: correlación de Black y rescate del aprendiz por activo (panel de diez), ordenados por \emph {leverage} creciente. Rescate ${}= \max (\mathrm {M10},\mathrm {AutoML}) - \mathrm {M5}$ en accuracy. Nueve de los diez siguen la tendencia (a más \emph {leverage} negativo, más rescate); ROKU es la excepción. Sobre los diez: Pearson $r = -0{,}56$ ($p = 0{,}093$), Spearman $\rho = -0{,}59$ ($p = 0{,}074$); tendencia significativa al $\alpha = 0{,}10$ pre-registrado}{table.6.7}{}}
\newlabel{tab:mp-ley@cref}{{[table][7][6]6.7}{[1][34][]35}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6.4}{\ignorespaces Rescate del aprendiz en accuracy frente al \emph  {leverage} del activo, sobre los diez. Cada punto es un activo; el eje horizontal es la correlación de Black $\operatorname  {corr}(r_t,\ \mathrm  {RV}^{21}_{t+1}-\mathrm  {RV}^{21}_t)$, el vertical el rescate $\mathop {\mathgroup \symoperators m\acute  {a}x}(\mathrm  {M10},\mathrm  {AutoML}) - \mathrm  {M5}$. La recta de regresión baja con el \emph  {leverage}: a más \emph  {leverage} negativo, más rescate (Pearson $r = -0{,}56$, $p = 0{,}093$; tendencia significativa al $\alpha = 0{,}10$ pre-registrado). Nueve de los diez la siguen; ROKU, señalado, es la excepción.}}{35}{figure.6.4}\protected@file@percent }
\newlabel{fig:mp-scatter}{{6.4}{35}{Rescate del aprendiz en accuracy frente al \emph {leverage} del activo, sobre los diez. Cada punto es un activo; el eje horizontal es la correlación de Black $\operatorname {corr}(r_t,\ \mathrm {RV}^{21}_{t+1}-\mathrm {RV}^{21}_t)$, el vertical el rescate $\max (\mathrm {M10},\mathrm {AutoML}) - \mathrm {M5}$. La recta de regresión baja con el \emph {leverage}: a más \emph {leverage} negativo, más rescate (Pearson $r = -0{,}56$, $p = 0{,}093$; tendencia significativa al $\alpha = 0{,}10$ pre-registrado). Nueve de los diez la siguen; ROKU, señalado, es la excepción}{figure.6.4}{}}
\newlabel{fig:mp-scatter@cref}{{[figure][4][6]6.4}{[1][34][]35}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6.8}{\ignorespaces Perfil de los tres grupos del \emph  {clustering} de la naturaleza de los diez activos (cinco rasgos: \emph  {leverage}, retorno medio en Crisis, fracción en Crisis, volatilidad OOS, sesgo del agente): \emph  {leverage} medio de cada grupo y su mejor canal de rescate. Los cuatro métodos coinciden en esta misma partición (Rand $= 1{,}0$, silueta $0{,}55$).}}{36}{table.6.8}\protected@file@percent }
\newlabel{tab:mp-cluster}{{6.8}{36}{Perfil de los tres grupos del \emph {clustering} de la naturaleza de los diez activos (cinco rasgos: \emph {leverage}, retorno medio en Crisis, fracción en Crisis, volatilidad OOS, sesgo del agente): \emph {leverage} medio de cada grupo y su mejor canal de rescate. Los cuatro métodos coinciden en esta misma partición (Rand $= 1{,}0$, silueta $0{,}55$)}{table.6.8}{}}
\newlabel{tab:mp-cluster@cref}{{[table][8][6]6.8}{[1][36][]36}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6.5}{\ignorespaces Proyección de la naturaleza de los diez activos sobre sus dos primeras componentes principales. Cada punto es un activo, coloreado por su cluster ($K=3$, partición unánime de los cuatro métodos, Rand $= 1{,}0$). El primer eje recupera el \emph  {leverage} ($r = 0{,}84$ entre PC1 y \texttt  {leverage\_corr}): el clustering ordena los activos, sin etiquetas de rescate, por el mismo eje que la ley del \emph  {leverage}. La leyenda marca el mejor canal de cada grupo (C0/C2 AutoML, C1 M10).}}{36}{figure.6.5}\protected@file@percent }
\newlabel{fig:mp-pca}{{6.5}{36}{Proyección de la naturaleza de los diez activos sobre sus dos primeras componentes principales. Cada punto es un activo, coloreado por su cluster ($K=3$, partición unánime de los cuatro métodos, Rand $= 1{,}0$). El primer eje recupera el \emph {leverage} ($r = 0{,}84$ entre PC1 y \texttt {leverage\_corr}): el clustering ordena los activos, sin etiquetas de rescate, por el mismo eje que la ley del \emph {leverage}. La leyenda marca el mejor canal de cada grupo (C0/C2 AutoML, C1 M10)}{figure.6.5}{}}
\newlabel{fig:mp-pca@cref}{{[figure][5][6]6.5}{[1][36][]36}{}{}{}}
